<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Clone Hero Companion" Manufacturer="Cr4zySh4rk"
           Version="$(AppVersion)" UpgradeCode="9A693893-86D8-47A2-83EC-56DC975983D5"
           Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Clone Hero Companion is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="build\icon\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Cr4zySh4rk/clone-hero-companion" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousLocation" Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                      Name="InstallDir" Type="raw" Bitness="always64" />
    </Property>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Clone Hero Companion" />
    </StandardDirectory>
    <!-- Shortcut choices. DESKTOPSHORTCUT / STARTMENUSHORTCUT are public: "1" creates the
         shortcut, "0" (or an unchecked box) does not. When unspecified they default to the
         remembered choice, else "1". Earlier choices are read from the registry in AppSearch. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="STARTMENUSHORTCUT" Secure="yes" />
    <Property Id="PREVDESKTOPSHORTCUT" Secure="yes" Value="1">
      <RegistrySearch Id="PrevDesktopChoice" Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                      Name="DesktopShortcutChoice" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="PREVSTARTMENUSHORTCUT" Secure="yes" Value="1">
      <RegistrySearch Id="PrevStartMenuChoice" Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                      Name="StartMenuShortcutChoice" Type="raw" Bitness="always64" />
    </Property>
    <!-- Wizard sequences apply the default before the dialog is shown. The execute sequence only
         applies it for silent/basic installs (UILevel below 4), so an unchecked box stays unchecked. -->
    <SetProperty Action="DefaultDesktopUi" Id="DESKTOPSHORTCUT" Value="[PREVDESKTOPSHORTCUT]"
                 After="AppSearch" Sequence="ui" Condition="DESKTOPSHORTCUT = &quot;&quot;" />
    <SetProperty Action="DefaultDesktopExec" Id="DESKTOPSHORTCUT" Value="[PREVDESKTOPSHORTCUT]"
                 After="AppSearch" Sequence="execute" Condition="DESKTOPSHORTCUT = &quot;&quot; AND UILevel &lt; 4" />
    <SetProperty Action="DefaultStartMenuUi" Id="STARTMENUSHORTCUT" Value="[PREVSTARTMENUSHORTCUT]"
                 After="AppSearch" Sequence="ui" Condition="STARTMENUSHORTCUT = &quot;&quot;" />
    <SetProperty Action="DefaultStartMenuExec" Id="STARTMENUSHORTCUT" Value="[PREVSTARTMENUSHORTCUT]"
                 After="AppSearch" Sequence="execute" Condition="STARTMENUSHORTCUT = &quot;&quot; AND UILevel &lt; 4" />
    <!-- Normalised 0/1 values that are written to the registry. -->
    <SetProperty Action="StoreDesktopOn" Id="StoredDesktopShortcut" Value="1"
                 Before="InstallValidate" Sequence="execute" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />
    <SetProperty Action="StoreDesktopOff" Id="StoredDesktopShortcut" Value="0"
                 Before="InstallValidate" Sequence="execute" Condition="DESKTOPSHORTCUT &lt;&gt; &quot;1&quot;" />
    <SetProperty Action="StoreStartMenuOn" Id="StoredStartMenuShortcut" Value="1"
                 Before="InstallValidate" Sequence="execute" Condition="STARTMENUSHORTCUT = &quot;1&quot;" />
    <SetProperty Action="StoreStartMenuOff" Id="StoredStartMenuShortcut" Value="0"
                 Before="InstallValidate" Sequence="execute" Condition="STARTMENUSHORTCUT &lt;&gt; &quot;1&quot;" />

    <ComponentGroup Id="AppRegistryGroup" Directory="INSTALLFOLDER">
      <Component Id="AppRegistry" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                       Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                       Name="DesktopShortcutChoice" Type="string" Value="[StoredDesktopShortcut]" />
        <RegistryValue Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                       Name="StartMenuShortcutChoice" Type="string" Value="[StoredStartMenuShortcut]" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Clone Hero Companion">
        <Component Id="StartMenuShortcut" Guid="*" Condition="STARTMENUSHORTCUT = &quot;1&quot;">
          <Shortcut Id="AppShortcut" Name="Clone Hero Companion" Target="[INSTALLFOLDER]CloneHeroCompanion.exe"
                    WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                         Name="StartMenuShortcut" Type="string" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <!-- Per-machine package: DesktopFolder resolves to the all-users desktop. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="AppDesktopShortcut" Name="Clone Hero Companion" Target="[INSTALLFOLDER]CloneHeroCompanion.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\Cr4zySh4rk\CloneHeroCompanion"
                       Name="DesktopShortcut" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Clone Hero Companion" Level="1">
      <Files Include="!(bindpath.Payload)\**" Directory="INSTALLFOLDER" />
      <ComponentGroupRef Id="AppRegistryGroup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Shortcut options page: WelcomeDlg > LicenseAgreementDlg > InstallDirDlg > ShortcutsDlg > VerifyReadyDlg -->
    <UI>
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose where Clone Hero Companion can be launched from." />
        <Control Id="DesktopCheck" Type="CheckBox" X="25" Y="65" Width="320" Height="18" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut" />
        <Control Id="StartMenuCheck" Type="CheckBox" X="25" Y="90" Width="320" Height="18" Property="STARTMENUSHORTCUT" CheckBoxValue="1" Text="Add to the Start menu" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- A later NewDialog on the same button wins over the stock one at Order 4. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5"
               Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="3"
               Condition="NOT Installed" />
    </UI>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="build\license.rtf" />
  </Package>
</Wix>
